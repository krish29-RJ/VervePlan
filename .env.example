# ============================================================================
# UtsavAI — Environment Configuration (.env.example)
# ============================================================================
# Copy this file to `.env.local` for local development.
# If GenAI API keys are omitted, UtsavAI automatically enables an explicit,
# persistent Demo Mode with full offline functionality and deterministic AI fallback.

# --- Google Gemini GenAI Configuration (Recommended for Google Prompt Wars) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# --- OpenAI Configuration (Alternative Provider) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Supabase Configuration (Optional in Demo Mode) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# --- Application Configuration ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
